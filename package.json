{
  "name": "our-commit",
  "version": "1.0.0",
  "description": "CLI que analisa o git diff em staging e gera uma mensagem de commit no padrão Conventional Commits usando IA (Claude ou OpenAI).",
  "main": "dist/index.js",
  "bin": {
    "our-commit": "dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "keywords": ["cli", "git", "ai", "commit", "conventional-commits", "typescript"],
  "author": "Enthony Silva",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
