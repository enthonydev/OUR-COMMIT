# Escolha um provedor e preencha a chave correspondente.
# Você só precisa preencher UMA das duas chaves abaixo.

# Anthropic (Claude) — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Provedor padrão usado quando nenhuma flag é passada (anthropic | openai)
OUR_COMMIT_PROVIDER=anthropic
